# sdkconfig.defaults — IOT-Tailscale
#
# Base común para todos los builds. Seleccionar perfil específico:
#   Desarrollo: SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.dev"
#   Producción: SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.prod"
#
# Flash encryption, NVS encryption y Secure Boot se activan SOLO
# en sdkconfig.prod (ADR-0003). Ninguna imagen de banco sale del
# laboratorio del usuario.

# Hardware real detectado: M5Stack Core 2, 16 MB flash (banco de pruebas,
# sesión 2026-08-20-banco-pruebas-core2).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partición factory más holgada que el default de 1 MB: margen para el
# stack de protocolo sin pelear por espacio en esta etapa.
# Tabla custom: incluye nvs_keys para NVS encryption (ADR-0003).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xB000

# Logs en INFO para el banco; bajar a ERROR/none recién en perfil de prod.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Stack de la tarea main: console + wifi app conviven acá al arranque.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# mbedTLS: habilitar ChaCha20-Poly1305 para Noise IK (ADR-0008).
# Estos tres módulos están deshabilitados por default en ESP-IDF.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
