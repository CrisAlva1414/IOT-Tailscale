# Copiar a .env y completar con valores reales (NUNCA commitear .env).
# Estos valores alimentan scripts/helpers de desarrollo del banco de pruebas.
# En el firmware, las credenciales entran por el serial console de
# provisioning (docs/adr/0007) o como constantes en main/tsnode_simple.c.

WIFI_SSID=<ssid>
WIFI_PASSWORD=<wifi-psk>
TAILSCALE_AUTH_KEY=tskey-auth-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX